NODE_ENV=production
PORT=3000
HELPER_HTTP_PORT=80

HELPER_API_KEY=replace-with-long-random-string
HELPER_PUBLIC_BASE_URL=http://YOUR_STATIC_IP_OR_DOMAIN:3000
HELPER_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

HELPER_AUTO_SCHEMA_BOOTSTRAP=true
HELPER_MEMORY_SCHEMA_FALLBACK=true
HELPER_DISK_STATE_FALLBACK=true
HELPER_STATE_DIR=/home/YOUR_USER/nodejs/.run/state
HELPER_LOCAL_PROOF_CHECK_ENABLED=true
HELPER_LOCAL_PROOF_CHECK_LANGUAGES=coq
LOCAL_PROOF_CHECK_TIMEOUT_MS=20000

GITHUB_EXECUTION_ENABLED=true
GITHUB_EXECUTION_TOKEN=
GITHUB_EXECUTION_REPOSITORY=ExpressPath/nodejs
GITHUB_EXECUTION_WORKFLOW=ivucx-proof-executor.yml
GITHUB_EXECUTION_REF=main
GITHUB_EXECUTION_TIMEOUT_MS=30000
GITHUB_EXECUTION_SYNC_WAIT_TIMEOUT_MS=45000
GITHUB_EXECUTION_SYNC_WAIT_POLL_MS=1500
GITHUB_EXECUTION_ENABLE_LEAN_CIC=false
GITHUB_EXECUTION_ENABLE_COQ_CIC=false
GCE_SYNC_REMOTE=executor
GCE_SYNC_REPO_URL=https://github.com/user-it0/nodejs.git
GCE_SYNC_REPO_REF=main
GCE_SYNC_LOCAL_BRANCH=main
GCE_SYNC_RUN_NPM_INSTALL=auto
GCE_SYNC_RESTART=true

HELPER_MAX_CODE_BYTES=200000
